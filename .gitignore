build/tiger_extracted/
__pycache__/
*.pyc
# Model pipeline artifacts now live outside the repo (config.PII_ROOT) because
# they carry voter PII and this tree is OneDrive-synced. Entry kept as a
# backstop for older checkouts and accidental local runs.
model/artifacts/
# CatBoost training logs
catboost_info/
.env
.claude/
build/cf-deploy/
.DS_Store
node_modules/
# Voter-bearing data files — PII, kept local only, rebuild DB from Supabase.
# Patterns, not a per-file list: a new CSV dropped into data/ must be ignored
# by default (CLAUDE.md rule 1). Public census geography already tracked here
# (TIGER shapefiles/zips, tiger_tracts_*.parquet) stays tracked -- .gitignore
# does not untrack what git already knows about.
data/**/*.csv
data/**/*.tsv
data/**/*.parquet
data/**/*.xlsx
data/**/*.xlsm
data/**/*.db
data/**/*.sqlite*
data/**/*.b64
data/**/*.gz
# Large intermediate build/cache files
data/fec_cache.json
data/nyboe_cache.json
data/nyccfb_cache.json

# Wrangler local state
.wrangler/

# Next.js
.next/
.env.local

# Supabase local dev (if using supabase CLI)
supabase/.temp/
.vercel
.env*


# TypeScript build cache
tsconfig.tsbuildinfo
.hallmark/

# Separate projects with their own toolchains (mirrors .vercelignore).
apps/*/node_modules/
apps/*/.expo/
services/*/.venv/

# Expo/EAS config scaffolded at the WRONG level. Running an `eas` command from
# the repo root instead of apps/canvass-ios makes the CLI treat the Next.js
# package.json as the Expo project: it writes a default eas.json or app.json
# here, stages it, and has also created a junk EAS project on the server. This
# happened three times between 2026-09-22 and 2026-09-26, once reaching `git
# add`. On a public repo a stray config at the root is worth making impossible
# to commit by accident.
#
# The leading slash anchors these to the repo root, so the real configs at
# apps/canvass-ios/eas.json and apps/canvass-ios/app.config.ts are untouched.
# (Already-tracked files are unaffected by .gitignore regardless.)
/eas.json
/app.json
