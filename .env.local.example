# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it contains secrets.
#
# .env.local is gitignored, so it lives only inside a working tree: `git clean -x`
# or `git worktree remove` deletes it and git has no copy to restore from. Keep a
# master copy outside the repo as well — model/db.py falls back to
# config.SECRETS_ENV (C:\data\rock_the_vote_secrets\.env.local by default, or
# $RTV_PII_ROOT/rock_the_vote_secrets/.env.local). The Next.js app still reads the
# repo-root copy, so keep both in sync.

# Supabase project URL and public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service role key — server-side only, never in NEXT_PUBLIC_* or client bundle
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Direct Postgres pooler connection string — server-side only.
# Session mode (port 5432). Used by model/db.py, which needs session-level
# semantics (temp tables inside transactions) for score write-back.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Transaction-mode pooler (port 6543) — same credentials, different port.
# Used by the Next.js app (lib/db.ts) instead of DATABASE_URL: it's the mode
# Supabase recommends for serverless, since it doesn't hold a dedicated
# backend connection per client for the connection's lifetime. Falls back to
# DATABASE_URL if unset.
DATABASE_POOL_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Anthropic API key — server-side only, used for AI targeting
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Dev and preview environments (task S-04) — see docs/dev_environments.md
# ---------------------------------------------------------------------------
# Three Supabase projects, one codebase:
#   prod     this file's values above — the live data, ~1.85M people
#   dev      Claude Code's workspace; a few turfs of real data
#   preview  EAS preview builds and the canvasser app
#
# Next.js picks the environment by FILE, not by variable name, because
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and so
# cannot be switched at runtime. Next.js loads .env.development.local ahead of
# .env.local when NODE_ENV=development, so:
#
#   .env.development.local   dev project   -> used by `npm run dev`
#   .env.local               prod          -> used by `npm run build && npm start`
#
# Copy the four NEXT_PUBLIC_*/SERVICE_ROLE/DATABASE_* lines above into
# .env.development.local with the DEV project's values. Both files are
# gitignored (.gitignore covers .env*) and the CI guard blocks either from
# being committed.
#
# model/ and scripts/ switch by variable instead, since they have no build
# step: model/db.py reads DATABASE_URL_DEV or DATABASE_URL_PREVIEW when asked
# for that target (--target dev, or RTV_DB_TARGET=dev). DATABASE_URL stays
# production, so every existing pipeline command is unaffected.
DATABASE_URL_DEV=postgresql://postgres.devref:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL_PREVIEW=postgresql://postgres.previewref:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
